# Não é necessário criar um .env para rodar via Docker — o docker-compose.yml
# injeta as variáveis de ambiente no container do backend (veja o bloco
# `environment` do serviço backend).
#
# Este arquivo serve apenas se você for rodar o backend FORA do Docker (PHP
# nativo na máquina hospedeira, com pdo_mysql). Nesse caso, copie para `.env`:
#
#   cp .env.example .env
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan app:seed
#   php artisan serve
#
# E ajuste as credenciais abaixo para o seu MySQL.

APP_NAME=InterlinkedLog
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=interlinkedlog
DB_USERNAME=interlinked
DB_PASSWORD=interlinked

# O TenantScope lê o company_id do request HTTP; em workers de fila não há
# request, portanto QUEUE_CONNECTION deve permanecer em sync (ou jobs precisam
# carregar company_id no payload e reaplicar o escopo no handle()).
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync