# Copie para `.env` se quiser sobrescrever os valores padrão usados pelo
# docker-compose.yml. Sem este arquivo, o compose sobe com os dev defaults
# (ver docker-compose.yml). Para produção, defina senhas fortes aqui.
#
#   cp .env.example .env

# MySQL (serviço mysql do compose)
MYSQL_ROOT_PASSWORD=interlinked-root
MYSQL_DATABASE=interlinkedlog
MYSQL_USER=interlinked
MYSQL_PASSWORD=interlinked

# Backend (chave de aplicação — gere com: php -r "echo 'base64:'.base64_encode(random_bytes(32));")
# APP_KEY=base64:...

# Ambiente (defaults seguros no compose: production / false; sobrescreva para dev)
# APP_ENV=local
# APP_DEBUG=true

# Frontend (apenas se rodar fora do Docker)
# VITE_API_URL=http://localhost:8080

# Modo demonstração: popula transportadoras, tabelas de frete, cotações e
# contratos FICTÍCIOS no primeiro boot, com login admin@interlinked.io/admin123.
# Desligado por padrão — um sistema novo começa vazio.
# DEMO_MODE=true

# Sem modo demo, o primeiro acesso vem daqui (o entrypoint cria empresa e admin):
# ADMIN_COMPANY=Minha Transportadora Ltda
# ADMIN_EMAIL=admin@minhaempresa.com.br
# ADMIN_PASSWORD=troque-esta-senha
